# 必填：调用 Anthropic API 的 Key
ANTHROPIC_API_KEY=sk-ant-...

# 可选：复用一个固定的 Cloud Environment ID。
# 不设置时，服务端首次请求会自动创建一个 Environment 并缓存在内存中
# (开发足够，生产建议显式设置以避免重启后重新创建)。
# ANTHROPIC_ENVIRONMENT_ID=env_...

# 可选：Session 创建时自动挂载的 Credential Vault（多个用逗号分隔）。
# 内含 MCP server 的 OAuth/凭证。例如挂上 GitHub MCP：
# ANTHROPIC_VAULT_IDS=vlt_011CabNkehSqWNPjz9qf2iPw
